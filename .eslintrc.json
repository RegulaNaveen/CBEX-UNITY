{
    "settings": {
        "react": {
            "version": "detect",
            "flowVersion": "0.121.0"
        }
    },
    "env": {
        "browser": true,
        "es6": true,
        "node": true,
        "mocha": true
    },
    "extends": [
        "eslint:recommended",
        "plugin:react/recommended",
        "airbnb",
        "prettier",
        "prettier/react",
        "plugin:flowtype/recommended",
        "prettier/flowtype"
    ],
    "parser": "babel-eslint",
    "globals": {
        "Atomics": "readonly",
        "SharedArrayBuffer": "readonly"
    },
    "parserOptions": {
        "ecmaFeatures": {
            "jsx": true
        },
        "ecmaVersion": 2018,
        "sourceType": "module"
    },
    "plugins": [
        "react",
        "prettier",
        "flowtype"
    ],
    "rules": {
        "react/jsx-no-bind": [
            "error",
            {
                "allowArrowFunctions": false,
                "allowFunctions": false,
                "allowBind": false
            }
        ],
        "no-console": 0,
        "react/default-props-match-prop-types": 0,
        "prefer-promise-reject-errors": 0,
        "no-underscore-dangle": 0,
        "react/forbid-prop-types": 0,
        "react/jsx-props-no-spreading": 0
    }
}