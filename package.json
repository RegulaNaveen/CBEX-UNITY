{
  "name": "gbo-efficiencies-frontend",
  "version": "1.0.0",
  "description": "GBO Efficiencies Frontend App",
  "main": "index.js",
  "scripts": {
    "dev": "webpack-dev-server --mode development",
    "build": "webpack --mode production",
    "coverage": "nyc _mocha test/helpers/browser.js 'test/**/*.spec.{js,jsx}' --timeout=3000",
    "test": "mocha test/helpers/browser.js 'test/**/*.spec.{js,jsx}'",
    "lint:fix": "eslint --ext .js,.jsx src test --fix",
    "flow:chk": "yarn run flow",
    "lint:chk": "eslint src/**/*.js src/**/*.jsx",
    "sanity": "yarn flow:chk && yarn lint:chk && yarn test"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "and": "^0.0.3",
    "css-loader": "^3.4.2",
    "node-sass": "^4.13.1",
    "react": "^16.13.1",
    "react-dom": "^16.13.1",
    "react-router-dom": "^5.1.2",
    "sass-loader": "^8.0.2",
    "style-loader": "^1.1.3"
  },
  "devDependencies": {
    "@babel/cli": "^7.8.4",
    "@babel/core": "^7.9.0",
    "@babel/plugin-proposal-class-properties": "^7.8.3",
    "@babel/polyfill": "^7.8.7",
    "@babel/preset-env": "^7.9.0",
    "@babel/preset-flow": "^7.9.0",
    "@babel/preset-react": "^7.9.4",
    "@babel/register": "^7.9.0",
    "babel-eslint": "^10.1.0",
    "babel-loader": "^8.1.0",
    "enzyme": "^3.11.0",
    "enzyme-adapter-react-16": "^1.15.2",
    "enzyme-to-json": "^3.4.4",
    "eslint": "^6.8.0",
    "eslint-config-airbnb": "^18.1.0",
    "eslint-config-prettier": "^6.10.1",
    "eslint-config-react": "^1.1.7",
    "eslint-loader": "^3.0.3",
    "eslint-plugin-flowtype": "^4.7.0",
    "eslint-plugin-import": "^2.20.1",
    "eslint-plugin-jsx-a11y": "^6.2.3",
    "eslint-plugin-prettier": "^3.1.2",
    "eslint-plugin-react": "^7.19.0",
    "expect": "^25.1.0",
    "flow-bin": "^0.84.0",
    "flow-typed": "^2.2.3",
    "html-webpack-plugin": "^4.0.1",
    "jsdom": "^16.2.1",
    "jsdom-global": "^3.0.2",
    "mocha": "^7.1.1",
    "nyc": "^15.0.0",
    "sinon": "^9.0.1",
    "webpack": "^4.42.1",
    "webpack-cli": "^3.3.11",
    "webpack-dev-server": "^3.10.3"
  },
  "nyc": {
    "check-coverage": true,
    "lines": 90,
    "include": [
      "src/**/*.js",
      "src/**/*.jsx"
    ],
    "exclude": [
      "src/**/*-compiled.js",
      "dist",
      "flow-typed"
    ],
    "extension": [
      ".jsx"
    ],
    "reporter": [
      "lcov",
      "text-summary"
    ],
    "require": [
      "@babel/register"
    ],
    "all": true
  },
  "directories": {
    "test": "test"
  }
}
