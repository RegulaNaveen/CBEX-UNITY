{
  "name": "gbo-efficiencies-frontend",
  "version": "1.0.0",
  "description": "GBO Efficiencies Frontend App",
  "main": "index.js",
  "scripts": {
    "dev": "webpack-dev-server --mode development --env.API_ENV=DEV",
    "dev:uat": "webpack-dev-server --mode development --env.API_ENV=UAT",
    "build:dev": "webpack --mode production --env.API_ENV=DEV",
    "build:sdev": "webpack --mode production --env.API_ENV=SDEV",
    "build:crm": "webpack --mode production --env.API_ENV=CRM",
    "build:uat": "webpack --mode production --env.API_ENV=UAT",
    "build:prod": "webpack --mode production --env.API_ENV=PROD",
    "coverage": "nyc _mocha test/helpers/browser.js 'test/**/*.spec.{js,jsx}' --timeout=3000",
    "test": "mocha test/helpers/browser.js 'test/**/*.spec.{js,jsx}'",
    "lint:fix": "eslint --ext .js,.jsx src test --fix",
    "flow:chk": "yarn run flow",
    "lint:chk": "eslint src/**/*.js src/**/*.jsx",
    "sanity": "yarn flow:chk && yarn lint:chk && yarn test"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@datapunt/matomo-tracker-react": "^0.3.1",
    "and": "^0.0.3",
    "apollo-react": "https://imshealth.myget.org/F/apollo/auth/205e1b20-2c34-4d3e-8fac-72f572e55f71/npm/apollo-react/-/3.19.2",
    "apollo-react-icons": "https://imshealth.myget.org/F/apollo/auth/205e1b20-2c34-4d3e-8fac-72f572e55f71/npm/apollo-react-icons/-/1.0.0-beta.7",
    "axios": "^0.19.2",
    "classnames": "^2.2.6",
    "core-js": "2",
    "css-loader": "^3.4.2",
    "date-fns": "^2.12.0",
    "diff": "^4.0.2",
    "file-loader": "^6.0.0",
    "immutable": "^4.0.0-rc.12",
    "jwt-decode": "^3.0.0-beta.2",
    "lodash": "^4.17.15",
    "moment": "^2.28.0",
    "node-sass": "^4.13.1",
    "randomcolor": "^0.6.2",
    "react": "^16.13.1",
    "react-day-picker": "^7.4.5",
    "react-dom": "^16.13.1",
    "react-iframe": "^1.8.0",
    "react-loader-spinner": "^3.1.14",
    "react-redux": "^7.2.0",
    "react-router-dom": "^5.1.2",
    "redux": "^4.0.5",
    "redux-thunk": "^2.3.0",
    "sass-loader": "^8.0.2",
    "style-loader": "^1.1.3",
    "url-loader": "^4.0.0",
    "uuid": "^8.3.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.8.4",
    "@babel/core": "^7.9.0",
    "@babel/plugin-proposal-class-properties": "^7.8.3",
    "@babel/plugin-proposal-export-default-from": "^7.8.3",
    "@babel/polyfill": "^7.8.7",
    "@babel/preset-env": "^7.9.0",
    "@babel/preset-flow": "^7.9.0",
    "@babel/preset-react": "^7.9.4",
    "@babel/register": "^7.9.0",
    "axios-mock-adapter": "^1.18.1",
    "babel-eslint": "^10.1.0",
    "babel-loader": "^8.1.0",
    "enzyme": "^3.11.0",
    "enzyme-adapter-react-16": "^1.15.2",
    "enzyme-to-json": "^3.4.4",
    "eslint": "^6.8.0",
    "eslint-config-airbnb": "^18.1.0",
    "eslint-config-prettier": "^6.10.1",
    "eslint-config-react": "^1.1.7",
    "eslint-loader": "^3.0.3",
    "eslint-plugin-flowtype": "^4.7.0",
    "eslint-plugin-import": "^2.20.1",
    "eslint-plugin-jsx-a11y": "^6.2.3",
    "eslint-plugin-prettier": "^3.1.2",
    "eslint-plugin-react": "^7.19.0",
    "expect": "^25.1.0",
    "flow-bin": "^0.123.0",
    "flow-typed": "^2.2.3",
    "html-webpack-plugin": "^4.0.1",
    "jsdom": "^16.2.1",
    "jsdom-global": "^3.0.2",
    "mocha": "^7.1.1",
    "nyc": "^15.0.0",
    "react-hot-loader": "^4.12.20",
    "sinon": "^9.0.1",
    "webpack": "^4.42.1",
    "webpack-cli": "^3.3.11",
    "webpack-dev-server": "^3.10.3"
  },
  "nyc": {
    "check-coverage": true,
    "lines": 90,
    "include": [
      "src/**/*.js",
      "src/**/*.jsx"
    ],
    "exclude": [
      "src/**/*-compiled.js",
      "dist",
      "flow-typed",
      "src/index.jsx",
      "src/SessionHandler.jsx"
    ],
    "extension": [
      ".jsx"
    ],
    "reporter": [
      "lcov",
      "text-summary"
    ],
    "require": [
      "@babel/register"
    ],
    "all": true
  },
  "directories": {
    "test": "test"
  }
}
